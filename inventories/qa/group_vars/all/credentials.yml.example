---
# QA credentials, used only when use_cyberark is false.
#   1. cp credentials.yml.example credentials.yml   (same folder)
#   2. replace every CHANGE_ME
#   3. ansible-vault encrypt inventories/qa/group_vars/all/credentials.yml
#   4. run playbooks with --ask-vault-pass
# credentials.yml is git-ignored. Plain text is for a throwaway test VM only.
mx_ssh_user: CHANGE_ME          # SSH login on the Murex app VM (has sudo)
mx_ssh_password: CHANGE_ME      # also used as its sudo password; "" for key-only
ora_ssh_user: CHANGE_ME         # SSH login on the Oracle host (has sudo)
ora_ssh_password: CHANGE_ME
db_admin_user: CHANGE_ME        # Oracle account for expdp/impdp and schema work
db_admin_password: CHANGE_ME
jfrog_user: CHANGE_ME
jfrog_token: CHANGE_ME          # JFrog access token or API key
